@MainActor @Suite struct NotesNativeStateVisualTests {
    @Test func renderPresentationStates() async throws {
        typealias Page = Notes.UI.List.Container.Page
        let actions = Page.Actions(onReload: .init { }, onCreate: .init { },
                                   onOpen: .init { _ in }, onRemove: .init { _ in })
        try await capture("loading", view: NavigationStack {
            Page(props: .init(notes: .initial()), actions: actions)
        })
        try await capture("load-error", view: NavigationStack {
            Page(props: .init(notes: .failure(.notImplemented)), actions: actions)
        })
        try await capture("empty", view: NavigationStack {
            Page(props: .init(notes: .success([])), actions: actions)
        })
        let note = Notes.Business.Model.Note(id: UUID(), createdAt: Date(timeIntervalSince1970: 123),
                                             title: "Weekend checklist", content: "Pack a notebook.\nBring coffee.")
        try await capture("save-error", view: NavigationStack {
            Notes.UI.Component.EditForm(
                props: .init(title: "Edit Note", note: note,
                             errorMessage: "Couldn’t save changes. Your draft is safe. Try again."),
                actions: .init(onSave: .init { _ in }, onCancel: .init { })
            )
        })
    }

    private func capture<V: View>(_ name: String, view: V) async throws {
        let scene = try #require(UIApplication.shared.connectedScenes.first as? UIWindowScene)
        let window = UIWindow(windowScene: scene)
        let controller = UIHostingController(rootView: view)
        window.rootViewController = controller
        window.frame = scene.coordinateSpace.bounds
        window.makeKeyAndVisible()
        defer { window.isHidden = true }
        controller.view.setNeedsLayout()
        controller.view.layoutIfNeeded()
        await Task.yield()
        let image = UIGraphicsImageRenderer(bounds: window.bounds).image { _ in
            window.drawHierarchy(in: window.bounds, afterScreenUpdates: true)
        }
        let data = try #require(image.pngData())
        let directory = FileManager.default.temporaryDirectory.appendingPathComponent("NativeNotesVisuals")
        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
        try data.write(to: directory.appendingPathComponent("\(name).png"))
    }
}
