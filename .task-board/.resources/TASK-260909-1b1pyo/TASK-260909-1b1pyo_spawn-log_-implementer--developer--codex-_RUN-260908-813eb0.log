    private func publishProtection(_ result: Result<Void, Notes.Business.Err>) async -> Relux.Flow.Result {
        let refresh = await obtainNotes()
        switch result {
        case .success: return refresh
        case .failure(let error): return .failure(error)
        }
    }
}
