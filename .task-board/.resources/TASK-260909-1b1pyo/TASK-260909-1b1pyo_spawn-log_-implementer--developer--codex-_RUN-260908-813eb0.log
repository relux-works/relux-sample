extension Notes.UI.Component {
    struct EditForm: Relux.UI.View {
        let props: Props
        let actions: Actions
        @State private var draft: Note
        @State private var isSaving = false
        @State private var confirmDiscard = false
        @FocusState private var focusedField: Field?

