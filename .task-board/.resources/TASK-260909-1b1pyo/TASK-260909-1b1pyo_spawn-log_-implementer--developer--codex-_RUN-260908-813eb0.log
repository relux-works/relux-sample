            let service = NotesTests.Business.ServiceMock()
            let flow = await Notes.Business.Flow(dispatcher: dispatcher, svc: service)

            let note = Model.Note.stubRandom()
            service.upsertNotesHandler = { _ in .success(()) }

                // Act
