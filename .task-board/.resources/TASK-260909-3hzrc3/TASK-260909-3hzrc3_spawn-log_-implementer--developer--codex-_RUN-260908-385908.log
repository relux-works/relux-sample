    10	struct AuthBehaviorTests {
    11	    @Test(arguments: [true, false])
    12	    func biometryReflectsAvailability(allowed: Bool) {
    13	        #expect(Auth.Business.Model.BiometryType.face(allowed: allowed).allowed == allowed)
    14	        #expect(Auth.Business.Model.BiometryType.touch(allowed: allowed).allowed == allowed)
    15	        #expect(Auth.Business.Model.BiometryType.other(allowed: allowed).allowed == allowed)
    16	    }
    17	
    18	    @Test
    19	    func authorizationTrueRoutesToMain() async {
    20	        let logger = await authorize(.success(true))
    21	        #expect(logger.actions.contains { ($0 as? Route) == .main })
    22	        #expect(logger.actions.contains { if case .authSucceed = $0 as? Auth.Business.Action { true } else { false } })
    23	    }
    24	
    25	    @Test
