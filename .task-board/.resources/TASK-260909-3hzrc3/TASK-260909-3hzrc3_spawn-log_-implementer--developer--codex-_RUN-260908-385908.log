    27	        let logger = await authorize(.success(false))
    28	        #expect(!logger.actions.contains { ($0 as? Route) == .main })
    29	        #expect(!logger.actions.contains { if case .authSucceed = $0 as? Auth.Business.Action { true } else { false } })
