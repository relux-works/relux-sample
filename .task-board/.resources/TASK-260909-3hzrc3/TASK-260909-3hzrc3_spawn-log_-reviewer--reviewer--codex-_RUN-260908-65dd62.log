+    var availableBiometry: Auth.Business.Model.BiometryType { .face(allowed: false) }
+    func runLocalAuth() -> Result<Bool, Auth.Business.Err> {
+        authCount += 1
+        return result
+    }
+    func recreateLAContext() { resetCount += 1 }
 }
