            Notes.Business.Effect.upsert(note: note)
            AppRouter.Action.removeLast()
        }
    }

    private func remove(_ note: Note) async {
        await actions {
            Notes.Business.Effect.delete(note: note)
            AppRouter.Action.removeLast(2)
